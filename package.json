{
  "name": "any-file-converter",
  "version": "1.2.0",
  "description": "File converter for Node.js and the command line: convert documents, spreadsheets, presentations, images, audio, video, ebooks, archives, data files and PDFs (docx to pdf, heic to jpg, mp4 to mp3, ...). Library, CLI and HTTP API.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "any-file-converter": "dist/cli/index.js",
    "converter": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "assets",
    "openapi.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "file converter",
    "file-converter",
    "converter",
    "convert",
    "document converter",
    "pdf",
    "docx to pdf",
    "pdf converter",
    "image converter",
    "heic",
    "audio converter",
    "video converter",
    "ffmpeg",
    "libreoffice",
    "pandoc",
    "ebook",
    "epub",
    "xlsx",
    "pptx",
    "csv",
    "json",
    "yaml",
    "cli",
    "api"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "cli": "node --experimental-strip-types src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "ag-psd": "^31.0.2",
    "express": "^5.1.0",
    "ini": "^7.0.0",
    "mailparser": "^3.9.28",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "smol-toml": "^1.9.0",
    "xml-js": "^1.6.11",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/ini": "^4.1.1",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Samad126/converterapi.git"
  },
  "homepage": "https://github.com/Samad126/converterapi#readme",
  "bugs": {
    "url": "https://github.com/Samad126/converterapi/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
