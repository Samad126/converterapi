{
  "name": "converterapi",
  "version": "1.0.0",
  "private": true,
  "description": "Universal file converter service: documents, spreadsheets, presentations and images, via LibreOffice headless.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\""
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
